pipeline {

    agent any

    environment {

        RESOURCE_GROUP = "rg-nodejs-mongo-dev"

        WEBAPP_NAME = "darshak-nodejs-mongo-web"

        ARTIFACT = "app-${BUILD_NUMBER}.tar.gz"

    }


    stages {


       stage('Download Artifact') {

            steps {

                copyArtifacts(
                projectName: 'nodejs-mongodb-ci',
                selector: lastSuccessful(),
                filter: '*.tar.gz'
            )

        }   
    }



stage('Azure Login') {
    steps {
        withCredentials([
            string(
                credentialsId: 'azure-sp-json',
                variable: 'AZURE_CREDENTIALS'
            )
        ]) {

            sh '''
            echo $AZURE_CREDENTIALS > azure.json

            az login \
            --service-principal \
            -u $(cat azure.json | jq -r .clientId) \
            -p $(cat azure.json | jq -r .clientSecret) \
            --tenant $(cat azure.json | jq -r .tenantId)

            az account set \
            --subscription $(cat azure.json | jq -r .subscriptionId)
            '''
        }
    }
}



stage('Deploy to Azure App Service') {

steps {

sh '''
az webapp deploy \
--resource-group rg-nodejs-mongo-dev \
--name darshak-nodejs-mongo-web \
--src-path app-${BUILD_NUMBER}.zip \
--type zip
'''

}

}



stage('Restart App') {

steps {

sh '''

az webapp restart \
--resource-group rg-nodejs-mongo-dev \
--name darshak-nodejs-mongo-web

'''

}

}



stage('Health Check') {

steps {

sh '''

sleep 30

curl -I https://darshak-nodejs-mongo-web.azurewebsites.net

'''

}

}