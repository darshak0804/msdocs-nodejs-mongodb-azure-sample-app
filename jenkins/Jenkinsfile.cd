pipeline {

    agent any


    environment {

        AZURE_WEBAPP_NAME = "darshak-nodejs-mongo-web"
        RESOURCE_GROUP = "rg-nodejs-mongo-dev"
        ARTIFACT = "app-${BUILD_NUMBER}.zip"

    }


    options {
        timestamps()
        disableConcurrentBuilds()
    }


    stages {


        stage('Download Artifact') {

            steps {

                copyArtifacts(
                    projectName: 'nodejs-mongodb-ci',
                    selector: specific("${BUILD_NUMBER}")
                )

            }
        }



        stage('Azure Login') {

            steps {

                withCredentials([
                    string(
                        credentialsId: 'azure-sp-json',
                        variable: 'AZURE_CREDENTIALS'
                    )
                ]) {


                    sh '''

                    echo "$AZURE_CREDENTIALS" > azure.json


                    az login \
                    --service-principal \
                    -u $(cat azure.json | jq -r .clientId) \
                    -p $(cat azure.json | jq -r .clientSecret) \
                    --tenant $(cat azure.json | jq -r .tenantId)


                    az account set \
                    --subscription $(cat azure.json | jq -r .subscriptionId)


                    '''

                }

            }

        }



        stage('Deploy to Azure App Service') {

            steps {

                sh '''

                az webapp deploy \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME} \
                --src-path ${ARTIFACT} \
                --type zip

                '''

            }

        }



        stage('Restart App') {

            steps {

                sh '''

                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME}

                '''

            }

        }




        stage('Health Check') {

            steps {

                sh '''

                sleep 30


                curl -I \
                https://${AZURE_WEBAPP_NAME}.azurewebsites.net


                '''

            }

        }


    }



    post {

        success {

            echo "Deployment completed successfully"

        }


        failure {

            echo "Deployment failed"

        }

    }


}