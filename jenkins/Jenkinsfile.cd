pipeline {

    agent any


    environment {

        AZURE_WEBAPP_NAME = "darshak-nodejs-mongo-web"
        RESOURCE_GROUP = "rg-nodejs-mongo-dev"

    }


    options {

        timestamps()
        disableConcurrentBuilds()

    }


    stages {


        stage('Download Artifact') {

            steps {

                echo "Downloading artifact from CI pipeline..."

                copyArtifacts(
                    projectName: 'nodejs-mongodb-ci',
                    selector: lastSuccessful()
                )

            }

        }



        stage('Azure Login') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'azure-client-id',
                        variable: 'AZURE_CLIENT_ID'
                    ),

                    string(
                        credentialsId: 'azure-client-secret',
                        variable: 'AZURE_CLIENT_SECRET'
                    ),

                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'AZURE_TENANT_ID'
                    )

                ]) {


                    sh '''

                    echo "Logging into Azure..."

                    az login \
                    --service-principal \
                    --username "$AZURE_CLIENT_ID" \
                    --password "$AZURE_CLIENT_SECRET" \
                    --tenant "$AZURE_TENANT_ID"


                    echo "Azure Account"

                    az account show

                    '''

                }

            }

        }




        stage('Prepare Deployment Package') {

            steps {

                sh '''

                echo "Finding CI artifact..."

                ARTIFACT=$(ls *.tar.gz | head -1)


                if [ -z "$ARTIFACT" ]; then

                    echo "No artifact found"
                    exit 1

                fi


                echo "Using artifact: $ARTIFACT"



                echo "Extracting artifact..."

                tar -xzf $ARTIFACT



                echo "Creating Azure deployment package..."

                rm -f deploy.zip



                zip -r deploy.zip . \
                -x ".git/*" \
                "jenkins/*" \
                "*.tar.gz" \
                "*.zip"



                echo "Deployment package created"

                ls -lh deploy.zip


                '''

            }

        }




        stage('Deploy to Azure App Service') {

            steps {

                sh '''

                echo "Deploying application to Azure App Service..."

                az webapp deploy \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME} \
                --src-path deploy.zip \
                --type zip



                echo "Deployment command completed"

                '''

            }

        }




        stage('Restart App Service') {

            steps {

                sh '''

                echo "Restarting App Service..."


                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME}



                '''

            }

        }




        stage('Health Check') {

            steps {

                sh '''

                echo "Waiting for application startup..."

                sleep 60



                APP_URL=$(az webapp show \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME} \
                --query defaultHostName \
                -o tsv)



                echo "Application URL:"
                echo "https://${APP_URL}"



                echo "Checking application health..."

                HTTP_STATUS=$(curl -o /dev/null -s -w "%{http_code}" https://${APP_URL})



                echo "HTTP Status: ${HTTP_STATUS}"



                if [ "$HTTP_STATUS" -eq 200 ]; then

                    echo "Application is healthy"

                else

                    echo "Application health check failed"

                    exit 1

                fi


                '''

            }

        }


    }



    post {


        success {

            echo "================================="
            echo "Deployment Successful"
            echo "================================="

        }



        failure {

            echo "================================="
            echo "Deployment Failed"
            echo "================================="

        }


    }


}