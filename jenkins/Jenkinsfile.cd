pipeline {

    agent any


    environment {

        AZURE_WEBAPP_NAME = "darshak-nodejs-mongo-web"
        RESOURCE_GROUP = "rg-nodejs-mongo-dev"
        ARTIFACT = "app-${BUILD_NUMBER}.zip"

    }


    options {
        timestamps()
        disableConcurrentBuilds()
    }


    stages {


        stage('Download Artifact') {

            steps {

                copyArtifacts(
                    projectName: 'nodejs-mongodb-ci',
                    selector: lastSuccessful()
                )

            }
        }


       stage('Azure Login') {

    steps {

        withCredentials([
            string(credentialsId: 'azure-client-id', variable: 'AZURE_CLIENT_ID'),
            string(credentialsId: 'azure-client-secret', variable: 'AZURE_CLIENT_SECRET'),
            string(credentialsId: 'azure-tenant-id', variable: 'AZURE_TENANT_ID')
        ]) {

            sh '''
            
            az login \
            --service-principal \
            --username "$AZURE_CLIENT_ID" \
            --password "$AZURE_CLIENT_SECRET" \
            --tenant "$AZURE_TENANT_ID"

            az account show

            '''
        }
    }
}



        stage('Deploy to Azure App Service') {

    steps {

        sh '''

        echo "Files after artifact download"
        ls -lah

        ZIP_FILE=$(ls *.zip | head -1)

        echo "Deploying $ZIP_FILE"

        az webapp deploy \
        --resource-group rg-nodejs-mongo-dev \
        --name darshak-nodejs-mongo-web \
        --src-path "$ZIP_FILE" \
        --type zip

        '''

    }
}



        stage('Restart App') {

            steps {

                sh '''

                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME}

                '''

            }

        }




        stage('Health Check') {

            steps {

                sh '''

                sleep 30


                curl -I \
                https://${AZURE_WEBAPP_NAME}.azurewebsites.net


                '''

            }

        }


    }



    post {

        success {

            echo "Deployment completed successfully"

        }


        failure {

            echo "Deployment failed"

        }

    }


}
