pipeline {

    agent any


    environment {

        AZURE_WEBAPP_NAME = "darshak-nodejs-mongo-web"
        RESOURCE_GROUP = "rg-nodejs-mongo-dev"
        ARTIFACT = "app-${BUILD_NUMBER}.zip"

    }


    options {
        timestamps()
        disableConcurrentBuilds()
    }


    stages {


        stage('Download Artifact') {

            steps {

                copyArtifacts(
                    projectName: 'nodejs-mongodb-ci',
                    selector: lastSuccessful()
                )

            }
        }


        stage('Azure Login') {
    steps {
        withCredentials([
            file(
                credentialsId: 'azure-sp-json',
                variable: 'AZURE_FILE'
            )
        ]) {

            sh '''
                echo "Logging into Azure"

                CLIENT_ID=$(grep clientId $AZURE_FILE | cut -d '"' -f4)
                CLIENT_SECRET=$(grep clientSecret $AZURE_FILE | cut -d '"' -f4)
                TENANT_ID=$(grep tenantId $AZURE_FILE | cut -d '"' -f4)

                az login \
                --service-principal \
                --username $CLIENT_ID \
                --password $CLIENT_SECRET \
                --tenant $TENANT_ID
            '''
        }
    }
}




        stage('Deploy to Azure App Service') {

            steps {

                sh '''

                az webapp deploy \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME} \
                --src-path ${ARTIFACT} \
                --type zip

                '''

            }

        }



        stage('Restart App') {

            steps {

                sh '''

                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME}

                '''

            }

        }




        stage('Health Check') {

            steps {

                sh '''

                sleep 30


                curl -I \
                https://${AZURE_WEBAPP_NAME}.azurewebsites.net


                '''

            }

        }


    }



    post {

        success {

            echo "Deployment completed successfully"

        }


        failure {

            echo "Deployment failed"

        }

    }


}
