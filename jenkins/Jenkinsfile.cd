pipeline {

    agent any

    environment {

        RESOURCE_GROUP = "rg-nodejs-mongo-dev"

        WEBAPP_NAME = "darshak-nodejs-mongo-web"

        ARTIFACT = "app-${BUILD_NUMBER}.tar.gz"

    }


    stages {


s       tage('Download Artifact') {

            steps {

                copyArtifacts(
                projectName: 'nodejs-mongodb-ci',
                selector: lastSuccessful(),
                filter: '*.tar.gz'
            )

        }   
    }



        stage('Azure Login') {

            steps {

                withCredentials([
                    azureServicePrincipal(
                    credentialsId: 'azure-sp-nodejs-mongo',
                    subscriptionIdVariable: 'AZURE_SUBSCRIPTION_ID',
                    clientIdVariable: 'AZURE_CLIENT_ID',
                    clientSecretVariable: 'AZURE_CLIENT_SECRET',
                    tenantIdVariable: 'AZURE_TENANT_ID'
                    )
                ]) {

                    sh '''

                    az login \
                    --service-principal \
                    -u $AZURE_CLIENT_ID \
                    -p $AZURE_CLIENT_SECRET \
                    --tenant $AZURE_TENANT_ID


                    az account set \
                    --subscription $AZURE_SUBSCRIPTION_ID


                    '''

                }

            }

        }



        stage('Deploy to Azure App Service') {

            steps {

                sh '''

                az webapp deploy \
                --resource-group ${RESOURCE_GROUP} \
                --name ${WEBAPP_NAME} \
                --src-path ${ARTIFACT} \
                --type zip


                '''

            }

        }



        stage('Restart App') {

            steps {

                sh '''

                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${WEBAPP_NAME}

                '''

            }

        }



        stage('Health Check') {

            steps {

                sh '''

                curl https://${WEBAPP_NAME}.azurewebsites.net/healthz

                '''

            }

        }

    }

}