pipeline {

    agent any


    environment {

        AZURE_WEBAPP_NAME = "darshak-nodejs-mongo-web"
        RESOURCE_GROUP = "rg-nodejs-mongo-dev"
        ARTIFACT = "app-${BUILD_NUMBER}.zip"

    }


    options {
        timestamps()
        disableConcurrentBuilds()
    }


    stages {


        stage('Download Artifact') {

            steps {

                copyArtifacts(
                    projectName: 'nodejs-mongodb-ci',
                    selector: lastSuccessful()
                )

            }
        }


        stage('Azure Login') {
    steps {
        withCredentials([
            file(credentialsId: 'azure-sp-json', variable: 'AZURE_JSON')
        ]) {

            sh '''
                echo "Logging into Azure..."

                az login --service-principal \
                --username $(grep clientId $AZURE_JSON | awk -F '"' '{print $4}') \
                --password $(grep clientSecret $AZURE_JSON | awk -F '"' '{print $4}') \
                --tenant $(grep tenantId $AZURE_JSON | awk -F '"' '{print $4}')

                az account show
            '''
        }
    }
}




        stage('Deploy to Azure App Service') {

            steps {

                sh '''

                az webapp deploy \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME} \
                --src-path ${ARTIFACT} \
                --type zip

                '''

            }

        }



        stage('Restart App') {

            steps {

                sh '''

                az webapp restart \
                --resource-group ${RESOURCE_GROUP} \
                --name ${AZURE_WEBAPP_NAME}

                '''

            }

        }




        stage('Health Check') {

            steps {

                sh '''

                sleep 30


                curl -I \
                https://${AZURE_WEBAPP_NAME}.azurewebsites.net


                '''

            }

        }


    }



    post {

        success {

            echo "Deployment completed successfully"

        }


        failure {

            echo "Deployment failed"

        }

    }


}
